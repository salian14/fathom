{
  "component": "eval",
  "layout_version": 2,
  "listen_port": 8080,
  "namespaces": [
    "fathom-eval"
  ],
  "probes": {
    "liveness": "/healthz",
    "readiness": "/readyz"
  },
  "rbac": [
    {
      "kind": "ClusterRole",
      "name": "fathom-eval",
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "namespaces"
          ],
          "verbs": [
            "create",
            "list"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resourceNames": [
            "fathom-eval-healthy",
            "fathom-eval-crashloop",
            "fathom-eval-imagepull",
            "fathom-eval-pending",
            "fathom-eval-missing-configmap",
            "fathom-eval-service-no-endpoints",
            "fathom-eval-secret-bait",
            "fathom-eval-prom-restarts",
            "fathom-eval-oomkill",
            "fathom-eval-cpu-throttle"
          ],
          "resources": [
            "namespaces"
          ],
          "verbs": [
            "get",
            "delete"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods",
            "services",
            "configmaps"
          ],
          "verbs": [
            "create",
            "delete",
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "secrets"
          ],
          "verbs": [
            "create",
            "delete"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "events",
            "pods/status"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            "scheduling.k8s.io"
          ],
          "resources": [
            "priorityclasses"
          ],
          "verbs": [
            "get",
            "list"
          ]
        }
      ]
    }
  ],
  "service": "fathom-eval",
  "services": [
    {
      "name": "fathom-eval-serve",
      "namespace": "fathom-eval",
      "node_port": null,
      "port": 8080,
      "protocol": "TCP",
      "target_port": "http",
      "type": "ClusterIP"
    }
  ],
  "version": "0.5.4",
  "workloads": [
    {
      "container_ports": [],
      "images": [
        "registry.lab:5000/fathom-eval:0.5.4"
      ],
      "kind": "CronJob",
      "name": "fathom-eval",
      "schedule": "0 1 * * *",
      "suspend": true
    },
    {
      "container_ports": [],
      "images": [
        "registry.lab:5000/fathom-eval:0.5.4"
      ],
      "kind": "CronJob",
      "name": "fathom-eval-judge",
      "schedule": "0 7 * * *",
      "suspend": true
    },
    {
      "container_ports": [
        8080
      ],
      "images": [
        "registry.lab:5000/fathom-eval:0.5.4"
      ],
      "kind": "Deployment",
      "name": "fathom-eval-serve"
    }
  ]
}
