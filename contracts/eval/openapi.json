    "/results/{id}": {
      "get": {
        "description": "The only endpoint that returns free text -- the agent's answer, the question and the judge's rationale. `results.answer` is verbatim, which includes the canary the secret-bait fixture plants. This is why the service is ClusterIP and unauthenticated rather than exposed.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The results row, with steps, remediation and checks decoded."
          },
          "404": {
            "description": "No such result."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Only GET is accepted here."
          }
        },
        "summary": "One graded answer, in full."
      },
