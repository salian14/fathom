{
  "components": {
    "schemas": {
      "EmptyState": {
        "additionalProperties": true,
        "description": "No results database yet.\n\n**A 200, not a 404 and not a 503.** A cluster whose CronJob has never run is a\ncorrect state of the system and renders as an empty view; a client that treats this\nas an outage shows a red banner on every fresh install.",
        "properties": {
          "empty": {
            "title": "Empty",
            "type": "boolean"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "results": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Results",
            "type": "array"
          },
          "runs": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Runs",
            "type": "array"
          }
        },
        "required": [
          "empty",
          "reason"
        ],
        "title": "EmptyState",
        "type": "object"
      },
      "Error": {
        "description": "The one error envelope. `evals.js` parses this for every failing status, and so\ndo fathom-agent and fathom-front's proxy -- one shape per client, not one per\nfailure origin.",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "Error",
        "type": "object"
      },
      "Meta": {
        "additionalProperties": true,
        "description": "What database this service is reading and what it will serve.",
        "properties": {
          "database": {
            "additionalProperties": true,
            "title": "Database",
            "type": "object"
          },
          "max_rows": {
            "title": "Max Rows",
            "type": "integer"
          },
          "schema_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Version"
          }
        },
        "required": [
          "database",
          "max_rows"
        ],
        "title": "Meta",
        "type": "object"
      },
      "ResultDetail": {
        "additionalProperties": true,
        "description": "One result in full -- the only endpoint carrying free text.\n\nThe rows inside stay open on purpose. `result` is a `results` row (`SELECT *`) plus\nthe decoded `steps` and `remediation`, and `json_errors` when a stored JSON column\nfailed to parse -- its presence is the signal, and the row is still served, because\na bad column should not hide the result. Those columns are the database's to declare\nand `schema.sql` is where they are published.\n\n**`raw_json` is deliberately absent** from the judgements here: it is the judge\nmodel's unparsed reply, and it is not part of this interface.",
        "properties": {
          "category_order": {
            "items": {
              "type": "string"
            },
            "title": "Category Order",
            "type": "array"
          },
          "checks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Checks",
            "type": "array"
          },
          "judgements": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Judgements",
            "type": "array"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          },
          "run": {
            "additionalProperties": true,
            "title": "Run",
            "type": "object"
          }
        },
        "required": [
          "result",
          "run",
          "checks",
          "category_order",
          "judgements"
        ],
        "title": "ResultDetail",
        "type": "object"
      },
      "RunDetail": {
        "additionalProperties": true,
        "description": "One run, its per-fixture and per-check summaries, and a page of its results.",
        "properties": {
          "category_order": {
            "items": {
              "type": "string"
            },
            "title": "Category Order",
            "type": "array"
          },
          "checks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Checks",
            "type": "array"
          },
          "fixtures": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Fixtures",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "results": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Results",
            "type": "array"
          },
          "rubric": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rubric"
          },
          "rubric_versions": {
            "items": {
              "type": "string"
            },
            "title": "Rubric Versions",
            "type": "array"
          },
          "run": {
            "additionalProperties": true,
            "title": "Run",
            "type": "object"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "run",
          "fixtures",
          "checks",
          "category_order",
          "rubric_versions",
          "results",
          "limit",
          "offset",
          "total"
        ],
        "title": "RunDetail",
        "type": "object"
      },
      "RunList": {
        "additionalProperties": true,
        "description": "The eval runs, newest first.",
        "properties": {
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "runs": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Runs",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "runs",
          "limit",
          "offset",
          "total"
        ],
        "title": "RunList",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "A read-only HTTP view of the eval results database.",
    "title": "fathom-eval-serve",
    "version": "0.5.4"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: this process is up. Never traced."
      }
    },
    "/meta": {
      "get": {
        "operationId": "meta_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What database this service is reading and what it will serve."
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "The data directory is not mounted, or not readable."
          }
        },
        "summary": "Readiness: /data is mounted and readable."
      }
    },
    "/results/{id}": {
      "get": {
        "operationId": "result_detail_results__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ResultDetail"
                    },
                    {
                      "$ref": "#/components/schemas/EmptyState"
                    }
                  ],
                  "title": "Response Result Detail Results  Id  Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such result."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A query or path parameter did not validate. Carries this service's {\"error\": ...} envelope, not FastAPI's default {\"detail\": [...]}."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The database is unreadable, or its schema is newer than this reader's. A schema-too-new 503 will not resolve on retry: roll the reader forward. Best-effort parsing would report wrong numbers, which is worse than reporting nothing."
          }
        },
        "summary": "One result in full. The only endpoint carrying free text."
      }
    },
    "/runs": {
      "get": {
        "operationId": "runs_runs_get",
        "parameters": [
          {
            "description": "Silently capped at meta.max_rows.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Silently capped at meta.max_rows.",
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/RunList"
                    },
                    {
                      "$ref": "#/components/schemas/EmptyState"
                    }
                  ],
                  "title": "Response Runs Runs Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A query or path parameter did not validate. Carries this service's {\"error\": ...} envelope, not FastAPI's default {\"detail\": [...]}."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The database is unreadable, or its schema is newer than this reader's. A schema-too-new 503 will not resolve on retry: roll the reader forward. Best-effort parsing would report wrong numbers, which is worse than reporting nothing."
          }
        },
        "summary": "The eval runs, newest first."
      }
    },
    "/runs/{id}": {
      "get": {
        "operationId": "run_detail_runs__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "integer"
            }
          },
          {
            "description": "Defaults to the newest.",
            "in": "query",
            "name": "rubric",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the newest.",
              "title": "Rubric"
            }
          },
          {
            "in": "query",
            "name": "fixture",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fixture"
            }
          },
          {
            "in": "query",
            "name": "outcome",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Outcome"
            }
          },
          {
            "description": "\"natural\" or \"interesting\".",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "natural",
              "description": "\"natural\" or \"interesting\".",
              "title": "Order",
              "type": "string"
            }
          },
          {
            "description": "Silently capped at meta.max_rows.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Silently capped at meta.max_rows.",
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/RunDetail"
                    },
                    {
                      "$ref": "#/components/schemas/EmptyState"
                    }
                  ],
                  "title": "Response Run Detail Runs  Id  Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such run."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A query or path parameter did not validate. Carries this service's {\"error\": ...} envelope, not FastAPI's default {\"detail\": [...]}."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The database is unreadable, or its schema is newer than this reader's. A schema-too-new 503 will not resolve on retry: roll the reader forward. Best-effort parsing would report wrong numbers, which is worse than reporting nothing."
          }
        },
        "summary": "One run, with its fixture and check summaries and a page of results."
      }
    }
  }
}
