        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "empty": {
                      "type": "boolean"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "runs": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "runs",
                    "limit",
                    "offset",
                    "total"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "An absent database is 200 with empty:true, not an error."
