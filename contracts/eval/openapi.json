{
  "components": {
    "schemas": {
      "Error": {
        "description": "The same envelope fathom-agent and fathom-front use, so a caller has one shape to parse rather than one per origin.",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A read-only HTTP view of the eval results database. It exists because SQLite is a library rather than a server, and fathom-front's eval view is in another namespace and cannot mount the volume. Unauthenticated and ClusterIP: never expose it.",
    "title": "fathom-eval-serve",
    "version": "0.5.4"
  },
  "openapi": "3.1.0",
