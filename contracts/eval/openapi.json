              "application/json": {
                "schema": {
                  "properties": {
                    "database": {
                      "description": "Path, presence and size of results.db.",
                      "type": "object"
                    },
                    "max_rows": {
                      "description": "The cap this service applies to any limit.",
                      "type": "integer"
                    },
                    "schema_version": {
                      "description": "Absent when there is no database. A version newer than the reader's is a 503, not a best-effort read.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "database",
                    "max_rows"
