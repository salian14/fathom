# Fathom / Ollama host configuration.
#
# Single source of truth for the model and the endpoint. setup.sh applies this to
# the host; the same OLLAMA_URL printed at the end of setup belongs in helm/ values
# so the in-cluster agent dials the right address. Change it here, re-run setup.sh,
# then update the chart -- never hardcode the endpoint in Go.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Base model pulled from the Ollama registry. Q4_K_M is ~6.6 GB on disk and needs
# roughly 8 GB of free VRAM/RAM to serve at the context length set below.
FATHOM_MODEL="qwen3.5:9b-q4_K_M"

# Derived alias created from the Modelfile that setup.sh generates. The agent
# requests THIS name, not FATHOM_MODEL, so serving parameters are pinned with the
# model rather than sent on every request. Swapping the base model is then a
# config change plus a re-run of setup.sh, invisible to the agent.
FATHOM_MODEL_ALIAS="fathom-agent"

# Context window. Tool output (especially k8s_log) is the main consumer here --
# raise it only alongside the k8s_log tail/byte cap, and watch memory: KV cache
# grows linearly with this value.
FATHOM_NUM_CTX="16384"

# Low temperature: this model picks tools and reads cluster state, it is not
# writing prose. Determinism matters more than variety.
FATHOM_TEMPERATURE="0.2"
FATHOM_TOP_P="0.9"

# ---------------------------------------------------------------------------
# Serving / network
# ---------------------------------------------------------------------------

# What the Ollama server binds to.
#
# 0.0.0.0 is the default because the agent runs in a k8s cluster on Vagrant/libvirt
# VMs and must reach the host across virbr0. Pinning to 192.168.122.1 instead would
# be tighter, but the unit then fails to start whenever virbr0 is down at boot --
# so bind broadly and restrict with the firewall (see FATHOM_FIREWALL below).
#
# Note that Ollama has no authentication. Anything that can reach this port can
# run inference and enumerate models.
OLLAMA_BIND="0.0.0.0:11434"

# The address the VMs / pods actually dial -- the host's IP on the network the
# cluster nodes are on. This is the single place the endpoint is defined: setup.sh
# prints it as ollama.url for helm/ values, and the agent dials it directly.
#
# It must be the node network, not just any libvirt bridge. virbr0 (192.168.122.1)
# is libvirt's default network and the nodes are NOT on it; they are on the
# vagrant_k8s0 bridge, virbr2, where the host is 192.168.56.1.
# Confirm both sides before changing:
#   kubectl get nodes -o wide     # the nodes' INTERNAL-IP
#   ip -brief addr show           # the host's address on that same subnet
OLLAMA_HOST_IP="192.168.56.1"
OLLAMA_PORT="11434"

# The subnet allowed to reach the port when FATHOM_FIREWALL=1. Keep in step with
# OLLAMA_HOST_IP -- pointing this at the wrong bridge silently locks the cluster
# out the moment the firewall is switched on.
FATHOM_ALLOWED_CIDR="192.168.56.0/24"

# Set to 1 to have setup.sh add a firewall rule limiting OLLAMA_PORT to
# FATHOM_ALLOWED_CIDR. Left off by default so the script does not silently
# reconfigure a firewall you may be managing elsewhere.
FATHOM_FIREWALL="0"

# ---------------------------------------------------------------------------
# Runtime tuning (systemd environment)
# ---------------------------------------------------------------------------

# Keep the model resident between agent turns. The default 5m causes a multi-second
# reload mid-conversation on an idle cluster; -1 pins it in memory indefinitely.
OLLAMA_KEEP_ALIVE="30m"

# One agent, one conversation at a time in phase 1. Raising these multiplies KV
# cache memory by the same factor.
OLLAMA_NUM_PARALLEL="1"
OLLAMA_MAX_LOADED_MODELS="1"

# ---------------------------------------------------------------------------
# Judge model, for the evaluation harness (eval/)
# ---------------------------------------------------------------------------
#
# `sudo ./setup.sh --judge` applies this block. It installs a SECOND Ollama
# instance as its own systemd unit, and the only reason it exists is that this
# host has one 8 GB GPU and the agent's model already fills it.
#
# qwen3.5:9b at num_ctx=16384 needs ~8 GB, which is the whole RTX 2070. With
# OLLAMA_MAX_LOADED_MODELS=1 above, loading a second model into the same
# instance EVICTS the agent's -- precisely what OLLAMA_KEEP_ALIVE=30m is set to
# avoid. So the judge runs pinned to the CPU (CUDA_VISIBLE_DEVICES="") in a
# separate instance on a separate port, and the two never contend for VRAM.
#
# The cost is speed: a 31B Q4 on this CPU is memory-bandwidth-bound at roughly
# 1.5-2.5 tok/s, so a judgement takes minutes rather than seconds. That is why
# the harness judges as a separate, sampled, nightly pass rather than inline.

# Already on disk -- deliberately NOT a new pull. The model store is 83 GB and
# the filesystem holding it has little room left, so the judge reuses a model
# that is already there. It is meaningfully more capable than the 9B it grades,
# which is the whole point of using a judge at all.
FATHOM_JUDGE_MODEL="gemma4:31b"

# Derived alias, same pattern as FATHOM_MODEL_ALIAS: serving parameters are
# pinned with the model rather than sent on every request.
FATHOM_JUDGE_MODEL_ALIAS="fathom-judge"

# Smaller than the agent's window: a judging prompt is a question, an answer and
# a tool-call summary -- there is no tool output in it. On CPU, context costs
# prefill time directly, so an oversized window is paid for on every judgement.
FATHOM_JUDGE_NUM_CTX="8192"

# Zero, not 0.2. A grader that disagrees with itself between runs is not a
# grader.
FATHOM_JUDGE_TEMPERATURE="0"

# Bound to the node network, NOT 127.0.0.1: the judge runs as an in-cluster
# CronJob, so localhost would be the pod. Same reasoning as OLLAMA_BIND above,
# and the same lack of authentication -- FATHOM_ALLOWED_CIDR covers both ports
# when FATHOM_FIREWALL=1.
OLLAMA_JUDGE_BIND="0.0.0.0:11435"
OLLAMA_JUDGE_PORT="11435"

# Short, unlike the agent's 30m. The judge holds ~19 GB resident while loaded
# and runs a few times a night; pinning that in RAM between passes would be
# 19 GB spent on nothing.
OLLAMA_JUDGE_KEEP_ALIVE="5m"
